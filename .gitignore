# ---- Python ----
__pycache__/
*.py[cod]
backend/.venv/
.venv/

# ---- Node ----
frontend/node_modules/
frontend/dist/
frontend/*.local

# ---- Server-local configuration / secrets ----
.env
.env.*
!.env.example
backend/config/datasets/*.local.json

