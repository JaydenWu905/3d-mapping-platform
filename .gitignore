backend/e2e_job.json
backend/sse_capture.txt

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
*.iml

# ---- Logs ----
*.log

# Host-local runtime and installation history (not release sources)
runtime/
ops/glim_install_logs/
ops/*.local.env
ops/glim-runtime.env
ops/releases/*/verification.local.json
