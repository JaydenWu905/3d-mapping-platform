#!/usr/bin/env bash
# Loaded by ops/platform.sh before it starts the backend. These GLIM_* values
# are consumed by the Pose adapter; this file does not source ROS or set the
# process-wide PYTHONPATH or LD_LIBRARY_PATH.
export GLIM_ROS_SETUP=/opt/ros/humble/setup.bash
export GLIM_NODE_COMMAND=/opt/ros/humble/lib/glim_ros/glim_rosnode
export GLIM_ROSBAGS_PYTHON=envs/glim_bridge/bin/python
export GLIM_CONFIG_PATH=3d-mapping-platform-deploy/ops/glim_runtime/config
export GLIM_LD_LIBRARY_PATH=/usr/local/lib
