# Copy to ops/glim-runtime.env in the deployment checkout; review paths first.
# Public machine configuration only. Do not put credentials in tracked files.
# GLIM_WORKSPACE defaults to the parent directory of the platform checkout.
export GLIM_WORKSPACE=/root/autodl-tmp
export GLIM_ROS_SETUP=/opt/ros/humble/setup.bash
export GLIM_NODE_COMMAND=/opt/ros/humble/lib/glim_ros/glim_rosnode
export GLIM_ROSBAGS_PYTHON=envs/glim_bridge/bin/python
export GLIM_CONFIG_PATH=3d-mapping-platform-deploy/ops/glim_runtime/config
export GLIM_LD_LIBRARY_PATH=/usr/local/lib
export MRHASH_ROOT=/root/autodl-tmp/mrhash
# Ensure pixi is on PATH, or keep the existing workspace/.pixi/bin/pixi layout.
# Do not source ROS globally into FastAPI; adapters source it in child shells.
# Leave MRHASH_B1_TRACE unset for the accepted deployment configuration.
